# ============================================
# MaxNews — Переменные окружения
# ============================================
# Скопируйте этот файл в .env и заполните значения
#
# ВАЖНО: Никогда не коммитьте .env в Git!
# Добавьте .env в .gitignore

# === ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ ===

# PostgreSQL
POSTGRES_USER=maxnews
POSTGRES_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD
POSTGRES_DB=maxnews
DATABASE_URL=postgresql://maxnews:CHANGE_THIS_TO_SECURE_PASSWORD@postgres:5432/maxnews

# Redis
REDIS_PASSWORD=CHANGE_THIS_TO_SECURE_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_THIS_TO_SECURE_REDIS_PASSWORD@redis:6379

# JWT Secret (сгенерируйте: openssl rand -hex 32)
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING

# MaxStat API (получить на https://maxstat.ru/promo/api)
MAXSTAT_API_KEY=your_maxstat_api_key_here
MAXSTAT_API_URL=https://api.maxstat.ru/v1

# MAX Bot (для публикации в канал)
MAX_BOT_TOKEN=your_max_bot_token_here
MAX_CHANNEL_ID=your_channel_id_here

# === ОПЦИОНАЛЬНЫЕ ПЕРЕМЕННЫЕ (для AI рерайта) ===
# Настройте хотя бы один провайдер для работы AI рерайта

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# DeepSeek (https://platform.deepseek.com/api_keys) - РЕКОМЕНДУЕМ, самый дешёвый
DEEPSEEK_API_KEY=

# OpenRouter (https://openrouter.ai/keys) - доступ к 100+ моделям
OPENROUTER_API_KEY=

# YandexGPT (https://console.cloud.yandex.ru/)
YANDEX_IAM_TOKEN=
YANDEX_FOLDER_ID=

# === ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ ===

# Frontend URL (для CORS)
FRONTEND_URL=http://localhost

# Application URL (для AI провайдеров)
APP_URL=http://localhost

# Node environment
NODE_ENV=production

# Порт backend (внутри контейнера)
PORT=3000
