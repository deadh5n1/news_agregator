# ============================================
# MaxNews — Переменные окружения
# ============================================
# Скопируйте этот файл в .env и заполните значения

# --- MaxStat API ---
MAXSTAT_API_KEY=your_maxstat_api_key_here
MAXSTAT_API_URL=https://api.maxstat.ru/v1

# --- MAX Bot (для публикации) ---
MAX_BOT_TOKEN=your_max_bot_token_here
MAX_CHANNEL_ID=your_channel_id_here

# --- PostgreSQL ---
POSTGRES_USER=maxnews
POSTGRES_PASSWORD=maxnews_secret
POSTGRES_DB=maxnews
DATABASE_URL=postgresql://maxnews:maxnews_secret@postgres:5432/maxnews

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- JWT ---
JWT_SECRET=change-this-to-a-random-secure-string

# --- Frontend ---
VITE_API_URL=http://localhost:3000

# --- Node ---
NODE_ENV=production
